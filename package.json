{
  "name": "@cmwl1231/dsh-notify",
  "version": "1.1.2",
  "description": "Windows toast notifications when a DSH task finishes or the agent needs you; click to return to DeepSeek-Harness, with a settings page inside DSH",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node test-plugin.mjs",
    "check": "node --check index.js && node --check client.js && node --check schema.js && node --check settings-store.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "toast",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lixiangdong122333/dsh-notify.git"
  },
  "homepage": "https://github.com/lixiangdong122333/dsh-notify#readme",
  "bugs": {
    "url": "https://github.com/lixiangdong122333/dsh-notify/issues"
  },
  "os": [
    "win32"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./schema": "./schema.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "schema.js",
    "settings-store.js",
    "notify.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
